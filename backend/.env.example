# Copy to backend/.env and adjust. Never commit the real .env.

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public URL of this API as seen by the browser (used by /api/bootstrap.js).
# The website reads its own copy from frontend/assets/js/api-config.js.
PUBLIC_API_BASE=https://api.example.com

# Browser origins allowed to call the API (comma separated).
# Required when the static site is on another host, for example:
#   https://YOUR-USER.github.io,https://www.example.com
# GitHub Pages project sites send the origin only (https://YOUR-USER.github.io).
ALLOWED_ORIGINS=

# Optional shared key. Only usable by non-browser clients: a public static site
# cannot hold a secret, so leave this empty for the website.
API_KEY=

# Rate limiting for /api (requests per window, per client IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Largest accepted JSON body, in bytes
MAX_BODY_BYTES=16384
